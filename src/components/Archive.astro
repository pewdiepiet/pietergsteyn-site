---
import { Image } from 'astro:assets';
import { liveProjects, yearOf } from '../data/projects';
import { stillsFor } from '../lib/stills';

/**
 * The still-photography half of the homepage (brief §4).
 *
 * One image per project, none of them the key still already shown in the
 * index panel, so scrolling reveals new work rather than repeating it.
 * Alternating measure gives an editorial rhythm without any decoration —
 * no cards, no borders, no crops. Every image keeps its native ratio.
 */
const plates = liveProjects
  .map((project) => {
    const stills = stillsFor(project.slug);
    if (stills.length === 0) return null;
    // Explicitly curated per project so the scroll shows new work rather than
    // repeating whatever the index panel is already holding.
    const pick = (project.archiveStill ?? project.keyStill ?? 1) - 1;
    return { project, still: stills[pick] ?? stills[0] };
  })
  .filter((p): p is NonNullable<typeof p> => p !== null);
---

<section class="archive" aria-label="Stills">
  <div class="shell head">
    <h2 class="marker">Stills</h2>
  </div>

  <div class="shell plates">
    {
      plates.map(({ project, still }, i) => (
        <figure
          class="plate"
          data-side={i % 2 === 0 ? 'left' : 'right'}
          style={`--ar:${(still.width / still.height).toFixed(4)}`}
        >
          <a href={`/projects/${project.slug}`}>
            <Image
              src={still}
              alt={`${project.title} — still`}
              widths={[600, 900, 1400]}
              sizes="(min-width: 60rem) 58vw, 100vw"
              loading="lazy"
              decoding="async"
            />
            <figcaption class="meta">
              <span class="cap-title">{project.title}</span>
              <span class="cap-year">{yearOf(project)}</span>
            </figcaption>
          </a>
        </figure>
      ))
    }
  </div>
</section>

<style>
  /* Desktop only. On mobile the index rows already carry a still each, so the
     list is image-led there and a second sequence would just repeat it (§17). */
  .archive {
    display: none;
    margin-top: var(--section);
  }

  .head {
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--rule);
  }

  .plates {
    display: grid;
    gap: 4rem;
    padding-top: 2.5rem;
  }

  .plate {
    margin: 0;
    max-width: min(100%, calc(84svh * var(--ar, 1.5)));
  }

  .plate :global(img) {
    width: 100%;
    height: auto;
  }

  figcaption {
    display: flex;
    gap: 0.6rem;
    padding-top: 0.7rem;
  }

  .cap-title { color: var(--ink); }
  .cap-year { color: var(--ink-faint); }

  .plate a {
    display: block;
    transition: opacity var(--dur) var(--ease);
  }

  .plate a:hover { opacity: 0.72; }

  @media (min-width: 60rem) {
    .archive { display: block; }

    .plates {
      gap: 5.5rem;
      padding-top: 3.5rem;
    }

    /* Alternating measure. Two positions only — a rhythm, not a scatter. */
    .plate { width: min(58%, calc(84svh * var(--ar, 1.5))); }
    .plate[data-side='right'] { margin-left: auto; }
  }
</style>
