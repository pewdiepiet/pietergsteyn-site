---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Film from '../../components/Film.astro';
import { liveProjects, catalogueNumber, shortRoles, yearOf, clientOf } from '../../data/projects';
import { stillsFor, keyStillFor, posterFor } from '../../lib/stills';

/**
 * One page per project, generated from src/data/projects.ts.
 * Adding a project never means authoring a page.
 *
 * Hierarchy, strictly (brief §8):   TITLE → VIDEO → STILLS
 */
export function getStaticPaths() {
  return liveProjects.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      number: catalogueNumber(i),
      prev: liveProjects[(i - 1 + liveProjects.length) % liveProjects.length],
      next: liveProjects[(i + 1) % liveProjects.length],
    },
  }));
}

const { project, number, prev, next } = Astro.props;

// Real photography only. A project with none simply shows no stills sequence.
const stills = stillsFor(project.slug);

const title = `${project.title} — Pieter Gabriël Steyn`;
const description = [
  project.title,
  clientOf(project),
  yearOf(project),
  project.roles.join(' & '),
].filter(Boolean).join(' · ');
---

<Base title={title} description={description}>
  <article class="project">
    {/* ── Title ─────────────────────────────────────────────────────────── */}
    <header class="shell head">
      <p class="marker num">{number}</p>
      <h1 class="title name">{project.title}</h1>

      <div class="facts meta">
        {clientOf(project) && <span>{clientOf(project)}</span>}
        <span>{yearOf(project)}</span>
        <span>{project.category}</span>
      </div>

      <p class="roles meta">{project.roles.join(' / ')}</p>

      {project.description && <p class="prose blurb">{project.description}</p>}
    </header>

    {/* ── Film ──────────────────────────────────────────────────────────── */}
    {
      project.films.length > 0 && (
        <section class="films" aria-label="Film">
          {project.films.map((film, i) => (
            <Film film={film} poster={posterFor(project.slug, i, project.keyStill)} priority={i === 0} />
          ))}
        </section>
      )
    }

    {/* ── Stills ────────────────────────────────────────────────────────── */}
    {
      stills.length > 0 && (
        <section class="stills" aria-label="Stills">
          {stills.map((still, i) => (
            <figure class="still" style={`--ar:${(still.width / still.height).toFixed(4)}`}>
              <Image
                src={still}
                alt={`${project.title} — still ${i + 1}`}
                widths={[720, 1200, 1800]}
                sizes="(min-width: 60rem) 78vw, 100vw"
                loading="lazy"
                decoding="async"
              />
            </figure>
          ))}
        </section>
      )
    }

    {/* ── Credits ───────────────────────────────────────────────────────── */}
    {
      project.credits && project.credits.length > 0 && (
        <section class="shell credits" aria-label="Credits">
          <h2 class="marker">Credits</h2>
          <dl class="credit-list meta">
            {project.credits.map((credit) => (
              <div class="credit">
                <dt>{credit.role}</dt>
                <dd>{credit.name}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {/* ── Navigation ────────────────────────────────────────────────────── */}
    <nav class="shell pager marker" aria-label="Projects">
      <a class="back" href="/">← Index</a>
      <span class="sides">
        <a href={`/projects/${prev.slug}`} rel="prev">Prev</a>
        <a href={`/projects/${next.slug}`} rel="next">Next</a>
      </span>
    </nav>
  </article>
</Base>

<style>
  .project { margin-top: var(--section); }

  /* ── Head ───────────────────────────────────────────────────────────── */
  .head {
    display: grid;
    gap: 0.3rem;
    padding-bottom: 2.5rem;
  }

  .num { color: var(--ink-faint); }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .facts > * + *::before {
    content: '/ ';
    color: var(--ink-faint);
  }

  .roles { color: var(--ink-faint); }

  .blurb {
    padding-top: 1.1rem;
    color: var(--ink);
  }

  /* ── Media ──────────────────────────────────────────────────────────── */
  .films,
  .stills {
    display: grid;
    gap: var(--margin);
  }

  .stills { padding-top: var(--margin); }

  /* Photography gets more room than film, but is still capped to the screen
     so a tall portrait reads as a photograph rather than a zoomed-in crop. */
  .still {
    margin: 0;
    max-width: min(100%, calc(88svh * var(--ar, 1.5)));
  }

  /* Native aspect ratio, always. Nothing is cropped to fit a box (§13). */
  .still :global(img) {
    width: 100%;
    height: auto;
  }

  /* Full-bleed on mobile so the photography owns the screen; inset on
     desktop so it sits inside the same margin system as the type. */
  @media (min-width: 60rem) {
    .films,
    .stills {
      padding-inline: var(--margin);
    }

    .head { padding-bottom: 3.25rem; }
  }

  /* ── Credits ────────────────────────────────────────────────────────── */
  .credits {
    margin-top: var(--section);
    display: grid;
    gap: 1rem;
  }

  .credit-list {
    display: grid;
    gap: 0.35rem;
    max-width: 34rem;
  }

  .credit {
    display: grid;
    grid-template-columns: minmax(0, 10rem) minmax(0, 1fr);
    gap: 1rem;
  }

  .credit dt { color: var(--ink-faint); }
  .credit dd { margin: 0; color: var(--ink); }

  /* ── Pager ──────────────────────────────────────────────────────────── */
  .pager {
    margin-top: var(--section);
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .sides {
    display: flex;
    gap: 1.5rem;
  }

  .pager a { transition: color var(--dur) var(--ease); }
  .pager a:hover { color: var(--ink); }
</style>
